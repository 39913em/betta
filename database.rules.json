{
  "rules": {
    "slots": {
      ".read": true,
      "$sid": {
        ".write": "auth != null && $sid.matches(/^s([1-9]|10)$/) && (data.child('owner').val() === auth.uid || (newData.child('owner').val() === auth.uid && (!data.child('owner').exists() || data.child('t').val() < now - 604800000)))",
        ".validate": "newData.hasChildren(['t','x'])",
        "owner": { ".validate": "newData.isString()" },
        "t": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "f": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000" },
        "n": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "x": { ".validate": "newData.val() === 0 || newData.val() === 1" },
        "d": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
